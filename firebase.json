{
  "functions": {
    "source": "backend"
  },
  "hosting": {
    "public": "frontend/dist",
    "rewrites": [
      { "source": "/api/**", "function": "api" },
      { "source": "/site/**", "function": "api" }
    ]
  },
  "emulators": {
    "singleProjectMode": true,
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true }
  }
}
